# ============================================================
#  NepMart — Multi-Vendor Marketplace
#  Copy this file to ".env" and adjust for your environment.
# ============================================================

# ---- Application ----
APP_NAME="NepMart Marketplace"
APP_ENV=production          # production | development
APP_DEBUG=false             # true shows detailed errors (set false in production)
# APP_URL is OPTIONAL — the app auto-detects its URL/sub-folder from the request.
# Leave it as-is for http://localhost/nepmart. Uncomment & set only for production:
# APP_URL=https://your-domain.com

# ---- Database (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=root
DB_PASS=

# ---- Session ----
SESSION_LIFETIME=7200
SESSION_NAME=nepmart_session

# ---- Security ----
CSRF_TOKEN_NAME=_csrf
